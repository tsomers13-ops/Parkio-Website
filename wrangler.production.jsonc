{
  "$schema": "node_modules/wrangler/config-schema.json",

  // PRODUCTION Worker. Deployed ONLY with an explicit
  //   --config wrangler.production.jsonc
  // The repo-root wrangler.jsonc is Preview, so a bare `wrangler deploy`
  // cannot reach Production by habit or by a forgotten flag.
  //
  // STAGING FORM: `routes` carries the CANARY hostname only. parkio.info
  // appears nowhere in this file, which is what makes an accidental
  // attachment impossible during staging rather than merely discouraged.
  // The cutover is one reviewed hunk swapping the route — see
  // docs/PRODUCTION-DEPLOYMENT-PLAN.md sections 1b and 7a.
  "name": "parkio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // CANARY STAGE: workers.dev is ON so the Production artifact has an HTTP
  // surface to validate against. This is the account-level subdomain
  // (parkio.<subdomain>.workers.dev) and needs NO zone permission, which is the
  // whole point — see the routes note below.
  //
  // Safe despite being public and Production-configured: with
  // PARKIO_COMMUNITY_WRITE_ENV=production the hostname guard allows only
  // parkio.info and www.parkio.info, so every sensitive write from a
  // workers.dev host is refused 403 forbidden_host before Origin, bearer,
  // validation or D1. Reads serve the same aggregates already public on
  // parkio.info, so there is no new disclosure.
  //
  // FLIP TO false AT CUTOVER, in the same reviewed change that adds the
  // parkio.info route.
  "workers_dev": true,
  "preview_urls": false,

  "observability": { "enabled": true },

  // DELIBERATELY NO ROUTES.
  //
  // The canary previously declared a custom domain,
  // parkio-worker-canary.parkio.info. That hostname resolves into the
  // parkio.info zone, so wrangler added the zone to activeZones and called
  // GET /zones/{zone}/workers/routes to reconcile existing routes before
  // creating anything — which the CI token cannot do, by design. Run
  // 34763782305 uploaded the Worker fine and then failed there.
  //
  // With no routes at all, activeZones is empty and wrangler never touches the
  // zone API. That keeps the CI token free of any Workers Routes or DNS
  // permission, so it has no ability to alter parkio.info routing. Those
  // permissions are deferred to the separate cutover gate, where they are
  // genuinely unavoidable.
  //
  // At cutover this becomes:
  //   "routes": [{ "pattern": "parkio.info", "custom_domain": true }]
  // alongside "workers_dev": false.

  // PRODUCTION D1. Same database Pages binds today, by id — the migration
  // is a hosting change, not a data change.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "parkio-history",
      "database_id": "82b972d1-be63-4c0d-bbbb-8437860ebcd0"
    }
  ],

  // Drives lib/ratingsWriteHost.ts: production allows parkio.info and
  // www.parkio.info exactly, and nothing else. Set from the first canary
  // deploy so the canary is refused by the real policy.
  "vars": { "PARKIO_COMMUNITY_WRITE_ENV": "production" },

  // Distinct from Preview (2001/2002) so Preview traffic can never consume
  // Production allowance.
  "ratelimits": [
    {
      "name": "IDENTITY_MINT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "RATING_WRITE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    }
  ]

  // RATINGS_IDENTITY_SECRET is deliberately absent: installed once by hand
  // with the EXISTING Production value via
  //   npx wrangler secret put RATINGS_IDENTITY_SECRET --config wrangler.production.jsonc
  // Continuity of that value is what keeps issued iOS credentials valid.
}
