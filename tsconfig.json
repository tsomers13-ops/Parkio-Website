{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // workers/ holds independently-configured Cloudflare Worker subprojects
  // (their own tsconfig.json, their own Workers-specific globals like
  // DurableObjectNamespace/ScheduledEvent) — excluded here so the main
  // app's tsc/Next.js build never tries to check them against this
  // tsconfig's DOM-flavored lib, and vice versa.
  "exclude": ["node_modules", "workers"]
}
