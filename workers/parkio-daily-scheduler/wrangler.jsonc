{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Config only — nothing here provisions anything until an explicit
  // `wrangler deploy` is run, which is a separate, later, authorized step.
  // No workers_dev, no routes: this Worker has no fetch() handler and no
  // HTTP surface at all, by design (see src/index.ts).
  "name": "parkio-daily-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-11",
  "workers_dev": false,

  // Bracketed EDT/EST pairs — see src/easternTime.ts for why two entries
  // per real target time are enough to track DST with zero manual edits.
  //   45 10 * * * -> 6:45 AM EDT (UTC-4)
  //   45 11 * * * -> 6:45 AM EST (UTC-5)
  //   15 11 * * * -> 7:15 AM EDT health-check dispatch
  //   15 12 * * * -> 7:15 AM EST health-check dispatch
  "triggers": {
    "crons": ["45 10 * * *", "45 11 * * *", "15 11 * * *", "15 12 * * *"]
  },

  // Durable, concurrency-safe "has today already been dispatched" guard.
  // See src/dispatchGuard.ts.
  //
  // new_sqlite_classes, not new_classes: Cloudflare now requires every
  // new Durable Object namespace to use the SQLite storage backend (the
  // older key-value-only backend is no longer available for new
  // namespaces). Found while investigating the Workers Free plan
  // constraint below — this would have been rejected at actual deploy
  // time regardless of plan. DispatchGuard's own code needs no change:
  // the SQLite backend has full parity with the classic storage.get/
  // put/delete API DispatchGuard already uses (backed internally by a
  // hidden table), confirmed against Cloudflare's own docs before
  // relying on it.
  "durable_objects": {
    "bindings": [{ "name": "DISPATCH_GUARD", "class_name": "DispatchGuard" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DispatchGuard"] }],

  // Non-secret configuration.
  //
  // No send_email binding, deliberately: Cloudflare Email Sending
  // requires the Workers Paid plan. Replaced with dispatching a second
  // GitHub Actions workflow (HEALTH_CHECK_WORKFLOW_FILE) that fails, and
  // so triggers GitHub's own native failure-notification email, if
  // today's article isn't actually live — see README.md. This Worker now
  // has zero email-sending capability of any kind, which is also what
  // makes it fully compatible with the Workers Free plan: only Cron
  // Triggers (free) and a SQLite-backed Durable Object (free) are used.
  "vars": {
    "GITHUB_OWNER": "tsomers13-ops",
    "GITHUB_REPO": "Parkio-Website",
    "GITHUB_REF": "main",
    "GITHUB_WORKFLOW_FILE": "parkio-daily.yml",
    "HEALTH_CHECK_WORKFLOW_FILE": "parkio-daily-health-check.yml",
    "TARGET_HOUR_ET": "6",
    "TARGET_MINUTE_ET": "45",
    "HEALTH_CHECK_HOUR_ET": "7",
    "HEALTH_CHECK_MINUTE_ET": "15"
  }

  // Still deliberately NOT configured here, and NOT created by this PR —
  // requires a decision + provisioning at actual deploy time, per the
  // deployment checklist in README.md: secret `GITHUB_DISPATCH_TOKEN`,
  // set via
  //   npx wrangler secret put GITHUB_DISPATCH_TOKEN --config wrangler.jsonc
  // (a fine-grained GitHub PAT, scoped to Parkio-Website only, Actions:
  // Read and write, nothing else — now the ONLY credential this Worker
  // needs of any kind).
}
