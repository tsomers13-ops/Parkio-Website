{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Config only — nothing here provisions anything until an explicit
  // `wrangler deploy` is run, which is a separate, later, authorized step.
  // No workers_dev, no routes: this Worker has no fetch() handler and no
  // HTTP surface at all, by design (see src/index.ts).
  "name": "parkio-daily-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-11",
  "workers_dev": false,

  // Bracketed EDT/EST pairs — see src/easternTime.ts for why two entries
  // per real target time are enough to track DST with zero manual edits.
  //   45 10 * * * -> 6:45 AM EDT (UTC-4)
  //   45 11 * * * -> 6:45 AM EST (UTC-5)
  //   15 11 * * * -> 7:15 AM EDT fallback missed-publication check
  //   15 12 * * * -> 7:15 AM EST fallback missed-publication check
  "triggers": {
    "crons": ["45 10 * * *", "45 11 * * *", "15 11 * * *", "15 12 * * *"]
  },

  // Durable, concurrency-safe "has today already been dispatched" guard.
  // See src/dispatchGuard.ts.
  "durable_objects": {
    "bindings": [{ "name": "DISPATCH_GUARD", "class_name": "DispatchGuard" }]
  },
  "migrations": [{ "tag": "v1", "new_classes": ["DispatchGuard"] }],

  // Restricts this binding to send to exactly one address, enforced by
  // Cloudflare itself — independent of anything the Worker's own code
  // does. Even a future bug or compromise in this Worker could never
  // send email anywhere except tsomers13@gmail.com. Requires that
  // address to be added and verified under Email Routing's Destination
  // Addresses before any real send will succeed (see README.md's
  // deployment checklist) — the binding itself can still be declared and
  // deployed before that verification completes.
  "send_email": [{ "name": "SEND_EMAIL", "destination_address": "tsomers13@gmail.com" }],

  // Non-secret configuration. ALERT_TO_ADDRESS must exactly match the
  // send_email binding's destination_address above — the binding accepts
  // mail addressed to that one literal string, and these two values are
  // never templated against each other, so a mismatch here would make
  // every real send fail even after verification.
  "vars": {
    "GITHUB_OWNER": "tsomers13-ops",
    "GITHUB_REPO": "Parkio-Website",
    "GITHUB_WORKFLOW_FILE": "parkio-daily.yml",
    "GITHUB_REF": "main",
    "TARGET_HOUR_ET": "6",
    "TARGET_MINUTE_ET": "45",
    "FALLBACK_CHECK_HOUR_ET": "7",
    "FALLBACK_CHECK_MINUTE_ET": "15",
    "ALERT_FROM_ADDRESS": "alerts@parkio.info",
    "ALERT_TO_ADDRESS": "tsomers13@gmail.com"
  }

  // Still deliberately NOT configured here, and NOT created by this PR —
  // requires a decision + provisioning at actual deploy time, per the
  // deployment checklist in README.md: secret `GITHUB_DISPATCH_TOKEN`,
  // set via
  //   npx wrangler secret put GITHUB_DISPATCH_TOKEN --config wrangler.jsonc
  // (a fine-grained GitHub PAT, scoped to Parkio-Website only, Actions:
  // Read and write, nothing else).
}
