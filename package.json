{
  "name": "parkio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dining:generate": "vite-node scripts/generateDining.ts --",
    "dining:verify": "vite-node scripts/verifyDining.ts --",
    "dining:festival:validate": "vite-node scripts/validateFestivalDining.ts",
    "dining:festival:status": "vite-node scripts/festivalDiningStatus.ts",
    "build:cloudflare": "npx @cloudflare/next-on-pages@1.13.16",
    "dining:venuekeys:swift": "vite-node scripts/exportVenueKeysSwift.ts --",
    "cf:types": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts --include-runtime=false",
    "workers:build": "opennextjs-cloudflare build && opennextjs-cloudflare populateCache local",
    "workers:preview": "npm run workers:build && opennextjs-cloudflare preview",
    "workers:deploy:preview": "opennextjs-cloudflare build && opennextjs-cloudflare populateCache remote && wrangler deploy"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "next": "^15.5.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.12",
    "@types/leaflet.markercluster": "^1.5.4",
    "@types/node": "^20.14.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.19",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vitest": "^2.1.9",
    "wrangler": "^4.131.1"
  }
}
